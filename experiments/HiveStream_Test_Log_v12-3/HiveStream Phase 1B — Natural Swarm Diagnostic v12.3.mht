@charset "utf-8";

:root { color-scheme: dark; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }

body { margin: 0px; background: rgb(16, 19, 24); color: rgb(233, 237, 242); }

main { max-width: 1100px; margin: 0px auto; padding: 16px; }

h1 { margin: 0px 0px 6px; font-size: 1.45rem; }

h2 { font-size: 1rem; margin: 18px 0px 8px; }

p, label, button, input, select { font-size: 0.92rem; }

.controls, .grid { display: grid; gap: 8px; }

.controls { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }

.grid { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }

.card { background: rgb(23, 28, 35); border: 1px solid rgb(48, 56, 67); border-radius: 8px; padding: 10px; min-width: 0px; }

label { display: block; margin-bottom: 4px; color: rgb(174, 184, 196); }

input, select, button { width: 100%; box-sizing: border-box; border: 1px solid rgb(58, 70, 84); border-radius: 6px; background: rgb(15, 19, 24); color: rgb(233, 237, 242); padding: 8px; }

button { cursor: pointer; background: rgb(32, 42, 53); }

button:hover { background: rgb(42, 55, 69); }

pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 440px; overflow: auto; margin: 0px; font-size: 0.78rem; line-height: 1.35; }

.small { color: rgb(174, 184, 196); font-size: 0.8rem; }

.ok { color: rgb(155, 226, 143); }

.bad { color: rgb(255, 157, 157); }

.warn { color: rgb(255, 210, 138); }

video { width: 100%; max-height: 55vh; background: rgb(0, 0, 0); border-radius: 8px; }

#log { max-height: 360px; }
